# Masukkan API Key Google Gemini Anda di sini
# Untuk Vercel, tambahkan variabel ini di Dashboard: Project Settings > Environment Variables
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Gmail SMTP Configuration untuk Verifikasi Reset Password Dashboard
# Panduan mendapatkan App Password Gmail:
# 1. Buka Akun Google -> Keamanan -> Verifikasi 2 Langkah (aktifkan)
# 2. Buka "Sandi Aplikasi" (App Passwords): https://myaccount.google.com/apppasswords
# 3. Buat nama sandi aplikasi misalnya "Portfolio Admin", lalu salin 16 karakter passwordnya ke GMAIL_APP_PASSWORD
GMAIL_USER=akhoiri052@gmail.com
GMAIL_APP_PASSWORD=
RESET_PASSWORD_SECRET=

